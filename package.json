{
  "name": "monyema",
  "version": "1.3.0",
  "description": "MoneyMa - จัดการการเงินส่วนตัว",
  "main": "public/electron.js",
  "homepage": "./",
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && npm run electron\"",
    "build-app": "npm run build && electron-builder",
    "build-mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/ios": "^8.2.0",
    "axios": "^1.6.0",
    "chart.js": "^4.4.0",
    "electron-serve": "^1.1.0",
    "pdfkit": "^0.13.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.11.0",
    "recharts": "^3.8.0",
    "setuptools": "^0.0.1",
    "sqlite3": "^5.1.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.1",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "react-scripts": "5.0.1",
    "wait-on": "^7.0.1"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.finance.manager",
    "productName": "MoneyMa",
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "public/electron.js",
      "public/preload.js",
      "src/database/**/*",
      "package.json",
      "!node_modules/sqlite3/build/{**/*}",
      "!node_modules/sqlite3/deps/{**/*}",
      "!node_modules/sqlite3/src/{**/*}"
    ],
    "extraResources": [
      {
        "from": "node_modules/sqlite3",
        "to": "app.asar.unpacked/node_modules/sqlite3",
        "filter": [
          "lib/**/*",
          "package.json",
          "build/Release/node_sqlite3.node"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance"
    }
  }
}
