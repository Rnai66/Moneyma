{
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/r/**",
        "destination": "/r/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
