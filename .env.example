# App URL
# Used for auth redirects and deployment builds.
REACT_APP_SITE_URL=https://your-domain.example.com
REACT_APP_NATIVE_AUTH_REDIRECT_URL=moneyma://auth

# Supabase Configuration
# Copy these from Supabase -> Settings -> API.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# Development-only auth bypass
# Keep this "false" in production builds.
REACT_APP_ENABLE_DEV_AUTH_BYPASS=false
REACT_APP_DEV_BYPASS_EMAIL=dev@moneyma.local
REACT_APP_DEV_BYPASS_USER_ID=dev-bypass-user

# Firebase Web App Configuration
# Copy these from Firebase Console -> Project settings -> Your apps -> Web app.
# Important: REACT_APP_FIREBASE_APP_ID must be the Web app ID, not the iOS or Android app ID.
REACT_APP_FIREBASE_API_KEY=your-api-key-here
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
REACT_APP_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
# Optional. Leave blank if Analytics is not enabled for the web app.
REACT_APP_FIREBASE_MEASUREMENT_ID=

# เปิดการขายผ่าน Google Play / App Store (ดู src/config/billing.js)
# ตั้งเป็น true ก็ต่อเมื่อ: คีย์ RevenueCat จริง + product Activate ครบ + offering เป็น Current + ทดสอบซื้อผ่านแล้ว
REACT_APP_NATIVE_BILLING=false

# โดเมนที่ QR บนใบเสร็จ POS จะพาไป (หน้า /r/)
# 🔴 ต้องตั้งเสมอสำหรับบิลด์มือถือ — บนแอป window.location.origin เป็น capacitor://
#    ถ้าไม่ตั้ง ใบเสร็จจะพิมพ์ออกมาโดยไม่มี QR
REACT_APP_RECEIPT_BASE_URL=https://your-web-app-domain
